# Copy to .env.local for local development, and set the same values in
# Vercel (Project > Settings > Environment Variables) for Production and Preview.
#
# Leave the Supabase and Clerk values empty to preview the site with
# placeholder content: the build still works, Clerk is switched off and /admin
# shows a "not configured" notice.
#
# The app never needs the Supabase service role key: Row Level Security and the
# signed-in admin's Clerk session token authorize every write.

# --- Supabase ---------------------------------------------------------------
# Project URL: Supabase dashboard -> Project Settings -> Data API (or `supabase
# status` locally, where it is http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public client key: the publishable key (sb_publishable_..., Project Settings ->
# API Keys). The legacy anon key also works; if both are set, the publishable key wins.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<legacy-anon-key>

# --- Clerk ------------------------------------------------------------------
# Clerk dashboard -> Configure -> API keys. Use the development instance
# (pk_test_/sk_test_) locally and on Vercel Preview, and the production instance
# (pk_live_/sk_live_) on Vercel Production. CLERK_SECRET_KEY is server-only:
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional: Clerk reads these too. The app already passes /sign-in to Clerk.
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# --- Site -------------------------------------------------------------------
# Canonical site URL for metadata, Open Graph tags, robots.txt and the sitemap,
# e.g. your custom .me domain. On Vercel it falls back to the production domain
# (VERCEL_PROJECT_PRODUCTION_URL) when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Repository linked from "How this site is built". Set to an empty value to hide the button.
# NEXT_PUBLIC_SOURCE_REPO_URL=https://github.com/<you>/<repo>

# --- Supabase CLI (local stack only, not read by Next.js) --------------------
# config.toml enables Clerk third-party auth with domain = env(CLERK_DOMAIN).
# Export it (or put it in supabase/.env) before `supabase start`. It is the
# Clerk domain shown at https://dashboard.clerk.com/setup/supabase, e.g.
# happy-cat-12.clerk.accounts.dev.
# CLERK_DOMAIN=<your-instance>.clerk.accounts.dev
