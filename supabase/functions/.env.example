# Local secrets for `npm run functions:serve` (copy to supabase/functions/.env).
# On a hosted project: npx supabase secrets set --env-file supabase/functions/.env
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_WEBHOOK_SECRET=change-me-to-a-long-random-string
CONTACT_NOTIFY_TO=you@example.com
# Must be a sender on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
CONTACT_NOTIFY_FROM=Portfolio <onboarding@resend.dev>
SITE_URL=http://localhost:3000
